# Copie este arquivo para "server/.env" e ajuste conforme o PC.

# Pasta onde o banco SQLite será gravado.
# IMPORTANTE: use uma pasta FORA do OneDrive/Drive/Dropbox para o banco não corromper.
# Exemplos:
#   DB_DIR=C:\controle-periodicos-data        (Windows)
#   DB_DIR=/var/lib/controle-periodicos       (Linux)
DB_DIR=C:\controle-periodicos-data

# Porta do servidor (site + API). Padrão 4000.
PORT=4000

# Senha do admin criado no primeiro boot (só usada na 1ª vez). Padrão: admin123
# ADMIN_SENHA=troque-aqui

# Segredo para assinar os tokens de login. Troque por um texto aleatório no servidor.
# JWT_SECRET=coloque-um-segredo-aleatorio-aqui
